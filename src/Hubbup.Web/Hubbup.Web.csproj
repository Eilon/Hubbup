<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8</TargetFramework>
    <UserSecretsId>hubbup</UserSecretsId>
    <LangVersion>preview</LangVersion> 
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ML\*.zip" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ML\*.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Remove="*-final-model.zip" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="*-final-model.zip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.6" />
    <PackageReference Include="Microsoft.Azure.SignalR" Version="1.25.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\issue-labeler-dotnet\src\LabelPredictor\Microsoft.DotNet.Github.LabelPredictor.csproj" />
    <ProjectReference Include="..\Hubbup.IssueMoverClient\Hubbup.IssueMoverClient.csproj" />
    <ProjectReference Include="..\IssueMoverDto\IssueMoverDto.csproj" />
  </ItemGroup>

</Project>
